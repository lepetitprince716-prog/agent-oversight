{
  "version": 1,
  "note": "Rules for check_integrity.py. classes: name -> path regexes (re.search on the repository-relative POSIX path); a file may belong to several classes. rules: kind 'added' fires on an added line matching a pattern; 'net-added' likewise, but a marker the same file also loses on a removed line (same pattern, same marker text) cancels one added copy, so a changed or moved line is not new; 'removed' fires on a removed line, except that in a hunk replacing as many lines as it adds (skip_lines aside) a line is reported only when the line in its place drops one of its words or adds a conjunction to an if: condition; 'net-loss' fires when all files of the class in the change together lose more matching lines than they gain, at each file with a loss of its own; 'deleted' fires when a file of the class is deleted or renamed out of the class. Renames are detected; a renamed file is judged by its changes. A deleted file is judged by 'deleted' rules only. allow: regexes tried at the start of each pattern match; a match where one of them matches is ignored. skip_lines: lines matching one of these are not looked at. existing_only: true skips files added by the change. spare_with_source: true (kind 'deleted' only) skips a deleted test file whose source file, by name (test_x.py or x_test.py and x.py, x_test.go and x.go, x.test.ts or x.spec.ts and x.ts or another JS/TS suffix), is deleted in the same change. severity: 'block' (the default) needs a Check-change line in the commit message; 'note' is printed and counted but never fails the run. An id may appear in several entries; they share one severity. A repository adjusts severity and appends allow-regexes per rule id in its own .check-integrity.json.",
  "classes": {
    "test": [
      "(^|/)tests?/",
      "(^|/)test_[^/]*\\.py$",
      "(^|/)[^/]*_test\\.py$",
      "(^|/)conftest\\.py$",
      "(^|/)[^/]*\\.(test|spec)\\.[cm]?[jt]sx?$",
      "(^|/)[^/]*_test\\.go$"
    ],
    "source": [
      "\\.(py|pyi|js|jsx|mjs|cjs|ts|tsx|mts|cts|rs|go|sh|bash|zsh|rb|java|kt|kts|c|cc|cpp|cxx|h|hh|hpp|cs|swift|php|lua|ps1)$",
      "(^|/)\\.githooks/",
      "(^|/)\\.husky/"
    ],
    "bypass": [
      "(^|/)\\.githooks/",
      "(^|/)\\.husky/",
      "(^|/)\\.pre-commit-config\\.ya?ml$",
      "(^|/)\\.?lefthook(-local)?\\.ya?ml$",
      "(^|/)\\.github/workflows/",
      "(^|/)\\.gitlab-ci\\.ya?ml$",
      "(^|/)\\.circleci/",
      "(^|/)azure-pipelines\\.ya?ml$"
    ],
    "script": [
      "(^|/)scripts?/",
      "(^|/)bin/",
      "\\.(sh|bash|zsh|ps1|cmd|bat)$",
      "(^|/)(GNUmakefile|[Mm]akefile)$",
      "\\.mk$",
      "(^|/)[Jj]ustfile$",
      "(^|/)package\\.json$",
      "(^|/)tox\\.ini$",
      "(^|/)noxfile\\.py$"
    ],
    "check": [
      "(^|/)\\.githooks/",
      "(^|/)\\.husky/",
      "(^|/)\\.pre-commit-config\\.ya?ml$",
      "(^|/)\\.?lefthook(-local)?\\.ya?ml$",
      "(^|/)\\.github/workflows/",
      "(^|/)\\.gitlab-ci\\.ya?ml$",
      "(^|/)\\.circleci/",
      "(^|/)\\.?ruff\\.toml$",
      "(^|/)\\.?mypy\\.ini$",
      "(^|/)\\.flake8$",
      "(^|/)\\.?pylintrc$",
      "(^|/)pyrightconfig\\.json$",
      "(^|/)pytest\\.ini$",
      "(^|/)\\.coveragerc$",
      "(^|/)\\.eslintrc([.][A-Za-z]+)?$",
      "(^|/)eslint\\.config\\.[cm]?[jt]s$",
      "(^|/)biome\\.jsonc?$",
      "(^|/)\\.?clippy\\.toml$",
      "(^|/)deny\\.toml$",
      "(^|/)\\.golangci\\.(ya?ml|toml|json)$",
      "(^|/)\\.shellcheckrc$",
      "(^|/)\\.stylelintrc([.][A-Za-z]+)?$",
      "(^|/)\\.markdownlint(-cli2)?\\.(jsonc?|ya?ml)$",
      "(^|/)tools/check_integrity\\.py$",
      "(^|/)tools/check_integrity_rules\\.json$",
      "(^|/)\\.check-integrity\\.json$",
      "(^|/)tools/privacy_scan\\.py$",
      "(^|/)tools/privacy_rules\\.json$"
    ],
    "mixed": [
      "(^|/)pyproject\\.toml$",
      "(^|/)setup\\.cfg$",
      "(^|/)tox\\.ini$",
      "(^|/)Cargo\\.toml$",
      "(^|/)[jt]sconfig[^/]*\\.json$",
      "(^|/)deno\\.jsonc?$",
      "(^|/)\\.gitattributes$"
    ]
  },
  "rules": [
    {
      "id": "skip-added",
      "kind": "added",
      "classes": [
        "test"
      ],
      "why": "a test in an existing test file is skipped, focused or expected to fail",
      "patterns": [
        "@unittest\\.(skip\\w*|expectedFailure)\\b",
        "^\\s*@(skip(If|Unless)?|expectedFailure)\\b",
        "\\bskipTest\\s*\\(",
        "\\bSkipTest\\b",
        "\\bpytest\\.mark\\.(skip\\w*|xfail)\\b",
        "\\bpytest\\.(skip|xfail)\\s*\\(",
        "(?<![\\w.$])(it|test|describe|context|suite)\\.(skip|only|todo|fails)\\b\\s*[.(`]",
        "(?<![\\w.$])[xf](it|test|describe|context)\\s*\\(\\s*['\"`]",
        "#\\[ignore\\b",
        "\\b[tb]\\.Skip(f|Now)?\\s*\\("
      ],
      "existing_only": true
    },
    {
      "id": "suppression-added",
      "kind": "net-added",
      "classes": [
        "source"
      ],
      "why": "a checker is told to look away (net new markers per file)",
      "severity": "note",
      "patterns": [
        "#\\s*type:\\s*ignore\\b",
        "#\\s*noqa\\b",
        "#\\s*ruff:\\s*noqa\\b",
        "#\\s*pyright:\\s*(ignore|basic)\\b",
        "#\\s*mypy:\\s*ignore-errors\\b",
        "#\\s*pylint:\\s*disable\\b",
        "#\\s*pragma:\\s*no\\s*cover\\b",
        "#\\s*nosec\\b",
        "@ts-(ignore|expect-error|nocheck)\\b",
        "\\beslint-disable",
        "\\bbiome-ignore\\b",
        "\\bdeno-lint-ignore",
        "(istanbul|c8|v8)\\s+ignore\\b",
        "#!?\\[(allow|expect)\\(",
        "//\\s*nolint\\b",
        "\\bNOLINT",
        "#\\s*shellcheck\\s+disable\\b",
        "@SuppressWarnings\\b"
      ],
      "skip_lines": [
        "^\\s*(from\\s+[\\w.]+\\s+)?import\\s[^#]*#\\s*noqa:\\s*(F401|E402|PLC0415)(\\s*,\\s*(F401|E402|PLC0415))*\\b(?!\\s*,)(?!.*(#|@ts-|eslint|NOLINT|nolint))"
      ]
    },
    {
      "id": "bypass-added",
      "kind": "added",
      "classes": [
        "bypass"
      ],
      "why": "a hook or CI step is told to ignore failure or skip checks",
      "patterns": [
        "--no-verify\\b",
        "\\bgit\\s+(commit|push|merge|am)\\b[^\\n]*\\s-n\\b",
        "\\|\\|\\s*true\\b",
        "\\|\\|\\s*:(?![\\w:])",
        "\\|\\|\\s*exit\\s+0\\b",
        "\\bset\\s+\\+e\\b",
        "\\bcontinue-on-error:\\s*['\"]?true\\b",
        "^\\s*-?\\s*if:\\s*(\\$\\{\\{\\s*)?false\\b",
        "\\ballow_failure:\\s*true\\b",
        "\\bHUSKY=0\\b",
        "\\bSKIP=\\S",
        "\\bcore\\.hooksPath\\b"
      ]
    },
    {
      "id": "bypass-added",
      "kind": "added",
      "classes": [
        "script"
      ],
      "why": "a script swallows the failure of a check command on the same line",
      "patterns": [
        "^(?=.*(?<![\\w-])(pytest|unittest|ruff|mypy|pyright|eslint|tsc|biome|clippy|cargo\\s+test|(npm|pnpm|yarn)\\s+(run\\s+)?test|bun\\s+test|go\\s+(test|vet))(?![\\w-])).*\\|\\|\\s*(true\\b|:(?![\\w:])|exit\\s+0\\b)"
      ]
    },
    {
      "id": "test-removed",
      "kind": "deleted",
      "classes": [
        "test"
      ],
      "why": "a test file was deleted while the source it tests stays",
      "spare_with_source": true
    },
    {
      "id": "test-removed",
      "kind": "net-loss",
      "classes": [
        "test"
      ],
      "why": "the change lost more test definitions than it gained, over all test files",
      "patterns": [
        "^\\s*(async\\s+)?def\\s+test\\w*\\s*\\(",
        "(?<![\\w.$])(it|test)\\s*\\(",
        "(?<![\\w.$])(it|test)\\.(each|concurrent)\\b",
        "#\\[(\\w+::)?test\\b",
        "^\\s*func\\s+(Test|Fuzz)\\w*\\s*\\("
      ]
    },
    {
      "id": "assertion-loss",
      "kind": "net-loss",
      "classes": [
        "test"
      ],
      "why": "the change lost more assertion lines than it gained, over all test files",
      "patterns": [
        "^\\s*assert\\b",
        "\\bself\\.(assert|fail)\\w*\\s*\\(",
        "\\b(np\\.testing\\.)?assert_\\w+\\s*\\(",
        "\\bpytest\\.raises\\s*\\(",
        "\\bexpect\\s*\\(",
        "\\bassert(\\.\\w+)?\\s*\\(",
        "\\b(debug_)?assert(_eq|_ne)?!\\s*\\(",
        "\\bt\\.(Error|Errorf|Fatal|Fatalf|Fail|FailNow)\\b",
        "\\b(require|assert)\\.[A-Z]\\w*\\s*\\("
      ]
    },
    {
      "id": "check-file-weakened",
      "kind": "deleted",
      "classes": [
        "check"
      ],
      "why": "a check file (hook, CI, lint or type config, scanner) was deleted"
    },
    {
      "id": "check-file-weakened",
      "kind": "removed",
      "classes": [
        "check"
      ],
      "why": "a line was removed from a check file",
      "patterns": [
        "\\S"
      ],
      "skip_lines": [
        "^\\s*(#|//|;|/\\*|\\*|<!--)"
      ]
    },
    {
      "id": "check-file-weakened",
      "kind": "removed",
      "classes": [
        "mixed"
      ],
      "why": "a line that tightens a check was removed",
      "patterns": [
        "\\bstrict\\w*[\"']?\\s*[:=]\\s*[\"']?(true|strict|error|all)\\b",
        "\\bnoImplicit\\w+",
        "\\bnoUnused\\w+",
        "\\bnoUnchecked\\w+",
        "\\bexactOptionalPropertyTypes\\b",
        "\\bdisallow_\\w+",
        "\\bwarn_(unused|return|redundant)\\w*",
        "\\bcheck_untyped_defs\\b",
        "\\bfail_under\\b",
        "--cov-fail-under\\b",
        "--strict\\w*",
        "\\b(extend-)?select\\s*=",
        "=\\s*[\"']?(deny|forbid|warn)[\"']?\\s*$",
        "\\bfilterwarnings\\b",
        "\\berror::",
        "\\bunsafe_code\\b",
        "\\[tool\\.(mypy|ruff|pyright|pylint|pytest|coverage|flake8|black)[\\].]",
        "\\[(lints|workspace\\.lints)[\\].]"
      ],
      "skip_lines": [
        "^\\s*(#|//|;)"
      ]
    },
    {
      "id": "check-file-weakened",
      "kind": "added",
      "classes": [
        "mixed"
      ],
      "why": "a line that loosens a check was added to an existing config file",
      "patterns": [
        "\\bstrict\\w*[\"']?\\s*[:=]\\s*[\"']?(false|off|basic|none)\\b",
        "\\b(extend-|per-file-)?ignores?\\w*[\"']?\\s*[:=]",
        "\\b(extend-|force-)?exclude\\w*[\"']?\\s*[:=]",
        "\\bignore_(errors|missing_imports)\\s*=\\s*true\\b",
        "\\bskip\\w*[\"']?\\s*[:=]",
        "\"skipLibCheck\"\\s*:\\s*true\\b",
        "\"checkJs\"\\s*:\\s*false\\b",
        "\\bfollow_imports\\s*=\\s*[\"']?(skip|silent)",
        "\\bfail_under\\s*=\\s*0\\b",
        "=\\s*[\"']allow[\"']",
        "\\blevel\\s*=\\s*[\"']allow[\"']",
        "--(ignore|deselect)\\b",
        "\\s-k\\s",
        "\\b(noqa|nosec)\\b",
        "(^|\\s)-diff\\b",
        "\\sbinary\\b",
        "\\blinguist-generated\\b"
      ],
      "skip_lines": [
        "^\\s*(#|//|;)"
      ],
      "existing_only": true
    }
  ]
}
